rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may access only their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Platform credentials are server-only, even for their owner.
      match /private/{document=**} { allow read, write: if false; }
    }
    // Licenses and all other records are accessed only by the trusted backend.
    match /{document=**} { allow read, write: if false; }
  }
}
